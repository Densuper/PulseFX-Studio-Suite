<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Precision Milled Dial Shadow -->
    <path
        android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
        android:fillColor="#55000000" />

    <!-- Brushed Aluminum Stylized 'P' Stem & Loop -->
    <path
        android:pathData="M38,32 L56,32 C65,32 72,39 72,48 C72,57 65,64 56,64 L46,64 L46,76 L38,76 Z M46,40 L46,56 L55,56 C59.5,56 63.5,52.5 63.5,48 C63.5,43.5 59.5,40 55,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="32"
                android:endX="72"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#E2E6EF" />
                <item android:offset="0.5" android:color="#B0B8C8" />
                <item android:offset="1.0" android:color="#7E8799" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Precision Rotary Dial Knob (Warm Gold Accent) -->
    <path
        android:pathData="M54,48m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="37"
                android:endX="65"
                android:endY="59"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD580" />
                <item android:offset="0.5" android:color="#E5A642" />
                <item android:offset="1.0" android:color="#996316" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rotary Indicator Notch -->
    <path
        android:pathData="M54,39 L54,43"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFF" />

    <!-- Parametric Acoustic Wave Crest (Tonal Gold) -->
    <path
        android:pathData="M70,48 Q74,38 76,48 T82,48"
        android:strokeWidth="2"
        android:strokeColor="#E5A642"
        android:fillColor="#00000000" />
</vector>
